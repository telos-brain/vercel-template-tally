# Clerk Authentication
# Optional for local `npm run dev`. Placeholder values enable a seeded
# local@localhost session. Real keys (pk_... / sk_...) are required on Vercel / production.
# https://dashboard.clerk.com/ -> API Keys
# Publishable keys start with pk_test_ or pk_live_; secret keys with sk_test_ or sk_live_.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key
CLERK_SECRET_KEY=your-clerk-secret-key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Supabase (Database & Storage)
# Local: values from `supabase start` (Publishable / Secret / Database URL)
# Hosted: https://supabase.com/dashboard/project/_/settings/api-keys
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Server-only — never expose to the browser (replaces legacy service_role)
SUPABASE_SECRET_KEY=your-supabase-secret-key
POSTGRES_URL=your-database-url

# App (invite emails and public links)
# Defaults in code are TALLY and http://localhost:3000 if unset.
NEXT_PUBLIC_APP_NAME=TALLY
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email — only required when inviting teammates (Organisation Settings)
POSTMARK_SERVER_TOKEN=your-postmark-server-token
FROM_EMAIL=notifications@example.com

# Telos Brain (Execution API)
# Dev: http://127.0.0.1:60061 after `brain start`
# Stage/prod: https://go.telosbrain.com (Telos Hosted)
# Per-brain key printed once on first `brain deploy` for that instance
BRAIN_URL=http://127.0.0.1:60061
BRAIN_API_KEY=your-brain-execution-api-key

# Tool webhooks (Brain → this app) — dual-secret handshake
# 1) Authorization: Bearer <TOOL_API_KEY>
# 2) X-Brain-Authorization: Bearer <BRAIN_API_KEY> (same value as above)
# Must equal MY_APP_API_KEY in brain/.env.local (dev) or brain/.env.stage|.env.prod
TOOL_API_KEY=your-shared-tool-api-key

# Daily insight heartbeat (GET /api/cron/daily-insights)
# Required on Vercel Preview/Production. Vercel cron sends Authorization: Bearer <CRON_SECRET>.
# Generate with: openssl rand -base64 32
# Leave unset locally — curl with Authorization: Bearer $BRAIN_API_KEY instead.
# Vercel Hobby does not run vercel.json crons.
CRON_SECRET=
