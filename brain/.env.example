# Telos Brain deploy credentials and brain environment variables.
#
# Dev: `brain start` writes `.env.local` (local Docker). Copy this file to
# `.env.stage` or `.env.prod` for Telos Hosted.
#
# The env file is loaded by `brain deploy --env <name>`. Real environment
# variables always take precedence over values in this file.
#
# TELOS_* variables are CLI/deploy configuration and are consumed locally —
# they are NEVER uploaded to the brain. Every OTHER variable declared below is
# uploaded on deploy and stored encrypted at rest. Leave a line blank or omit
# it to skip it.

# --- CLI / deploy configuration (never uploaded) ---

# Organisation API key. Local Docker: leave the well-known key that
# `brain start` writes into `.env.local`. Stage/prod: mint one at
# https://go.telosbrain.com (organisation admin). Shown only once.
TELOS_BRAIN_ORG_API_KEY=your-org-api-key

# Management / Execution API base URL.
# Dev: http://127.0.0.1:60061
# Stage/prod: https://go.telosbrain.com
TELOS_BRAIN_API_URL=https://go.telosbrain.com

# --- Brain environment variables (uploaded, encrypted at rest) ---

# LLM provider API keys. The model resolver maps a workflow's `model` prefix
# onto the conventional key name (e.g. `anthropic/claude-sonnet-4-6` ->
# ANTHROPIC_API_KEY, `openai/gpt-4o` -> OPENAI_API_KEY, `xai/grok-4.5` ->
# XAI_API_KEY, `openrouter/…` -> OPENROUTER_API_KEY). TALLY workflows pin
# Anthropic, so ANTHROPIC_API_KEY is enough when no brain default is set.
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# Local model runners — Ollama / llama.cpp (optional). Add one numbered entry
# per runner. The number maps to `local_{N}` in workflow model strings
# (e.g. `local_1/qwen3:8b`, `local_2/gemma4:e4b`). Presence of
# LOCAL_LLM_N_BASE_URL is the gate — if it is unset, that runner cannot be used.
# A trailing `/v1` is accepted and stripped; the conversant calls
# `{base}/v1/chat/completions`. From Brain-in-Docker, use host.docker.internal
# (not localhost) to reach a runner on the host (BRA106 §8).

# Ollama (Dockerised Brain connecting to the host):
# LOCAL_LLM_1_BASE_URL=http://host.docker.internal:11434/v1

# Ollama (native install, Brain running natively):
# LOCAL_LLM_1_BASE_URL=http://localhost:11434/v1

# llama.cpp server:
# LOCAL_LLM_1_BASE_URL=http://localhost:8080/v1

# Second runner (optional):
# LOCAL_LLM_2_BASE_URL=http://host.docker.internal:11435/v1

# Optional API key for secured local runners:
# LOCAL_LLM_1_API_KEY=your_optional_key_here

# Optional default LLM (provider/model). When set and the matching credential
# exists, every live run uses this model instead of the workflow frontmatter.
# Same role as Settings "Default LLM model" and brain-compose.yml `llm-model`.
# Leave blank to use each workflow's own `model:` (TALLY pins Anthropic).
# If that is also omitted, the run fails — leftover ANTHROPIC_API_KEY /
# OPENAI_API_KEY / XAI_API_KEY / OPENROUTER_API_KEY are not used as a silent default.
# Examples:
#   DEFAULT_LLM_MODEL=local_1/qwen3:8b
#   DEFAULT_LLM_MODEL=anthropic/claude-sonnet-4-6
#   DEFAULT_LLM_MODEL=openrouter/anthropic/claude-sonnet-4.6
DEFAULT_LLM_MODEL=

# Voyage — embedding provider for semantic search (find_available_skills,
# search_blueprint_entries, skill embeddings). Required when embedding-model is
# voyage-* (this brain defaults to voyage-3-lite). A local LLM does not
# replace this key.
VOYAGE_API_KEY=your-voyage-api-key

# Optional IANA timezone id used by {{now.local*}} template tags
# (e.g. Pacific/Auckland). When unset or unrecognised, local time falls back to UTC.
TIMEZONE=

# Per-brain Execution API key from first `brain deploy` (printed once).
# Same value as the host app's BRAIN_API_KEY. Required for tool callbacks.
BRAIN_API_KEY=your-brain-execution-api-key

# Host app (connectors/my-app.yml + finance / example tools).
# Dev (Brain-in-Docker → Next.js on the host): http://host.docker.internal:3000
# Stage/prod: https://your-app.example.com
# MY_APP_API_KEY must equal the app's TOOL_API_KEY.
MY_APP_API_URL=http://host.docker.internal:3000
MY_APP_API_KEY=your-shared-tool-api-key
